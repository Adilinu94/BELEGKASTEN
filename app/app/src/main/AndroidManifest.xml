<?xml version="1.0" encoding="utf-8"?>
<!--
  OFFLINE-GARANTIE: bewusst KEINE android.permission.INTERNET.
  Gebündelte ML-Kit-OCR, aktuell Text-/Feldsuche. Echter Modell-/PAD-Pack fehlt
  noch. Play-Billing nutzt den Play Store, nicht einen App-Netzwerkclient.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".BelegkastenApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.Belegkasten"
        android:allowBackup="false"
        android:fullBackupOnly="false"
        android:usesCleartextTraffic="false">
        <meta-data android:name="de.belegkasten.PLAY_PUBLIC_KEY" android:resource="@string/play_billing_public_key" />
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Teilen-Knopf: PDF + Bild aus jeder App (Phase-A-Fallback auch fuer E-Rechnung). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>
</manifest>
